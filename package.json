{
  "name": "dsh-prd-generator",
  "version": "0.3.3",
  "description": "By Ruby · DSH plugin: requirement clarification -> PRD -> prd.json (snarktank/ralph compatible) -> acceptance checklist, with a bundled skill.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "icon": "./icon.svg",
  "files": [
    "lib",
    "skills",
    "locale/*.json",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "prd",
    "product-requirements",
    "user-stories",
    "acceptance-criteria",
    "ralph"
  ],
  "author": "rubyzhao666",
  "license": "MIT",
  "homepage": "https://github.com/rubyzhao666/dsh-prd-generator",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rubyzhao666/dsh-prd-generator.git"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "smoke": "node scripts/smoke.mjs"
  }
}
